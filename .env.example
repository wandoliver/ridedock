APP_NAME="Open Cycling Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Activity import
ACTIVITY_SYNC_PAGE_SIZE=50
ACTIVITY_SYNC_OVERLAP_DAYS=2
ACTIVITY_SYNC_MAX_PAGES=100
ACTIVITY_STORE_SOURCE_FILES=true
ACTIVITY_SOURCE_FILE_DISK=activity_sources
FIT_NODE_BINARY=node
FIT_MAX_FILE_BYTES=52428800
FIT_PARSE_TIMEOUT_SECONDS=30
HEATMAP_PRIVACY_TRIM_M=400
HEATMAP_SAMPLE_EVERY=3

# Hammerhead / SRAM (disabled until your API application is approved)
HAMMERHEAD_ENABLED=false
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
HAMMERHEAD_REDIRECT_URI="${APP_URL}/api/v1/oauth/hammerhead/callback"
HAMMERHEAD_WEBHOOK_SECRET=
HAMMERHEAD_API_URL=https://api.hammerhead.io/v1/api
HAMMERHEAD_AUTH_URL=https://api.hammerhead.io/v1/auth
HAMMERHEAD_DISTANCE_MULTIPLIER=1000
HAMMERHEAD_DURATION_MULTIPLIER=1
