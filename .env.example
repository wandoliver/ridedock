APP_NAME="Open Cycling Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Enable daily destructive retention after reviewing docs/PRIVACY.md.
DATA_LIFECYCLE_SCHEDULED=false
INACTIVE_ACCOUNT_DAYS=730
PENDING_ACCOUNT_DAYS=30
FAILED_JOB_DAYS=7
ACCOUNT_AUDIT_DAYS=90
BACKUP_RETENTION_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI training analysis (disabled until key and model are set)
AI_QUEUE_CONNECTION=ai
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

# Shared operational controls; see docs/OPERATIONS.md.
HOSTED_SERVICE=false
# OPERATIONS_CACHE_STORE=database
OPERATIONS_MONITOR_SCHEDULED=false
AI_MONTHLY_ACTIVITY_QUOTA=100
AI_MONTHLY_PLAN_QUOTA=30
AI_USER_PENDING_LIMIT=2
AI_PENDING_LIMIT=100
AI_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=20
AI_MAX_OUTPUT_TOKENS=12000
AI_MONTHLY_BUDGET_USD=0
AI_BUDGET_WARNING_PERCENT=80
# Exact returned model ID and operator-supplied USD prices per million tokens.
AI_PRICING_MODEL=
AI_INPUT_USD_PER_MILLION=
AI_CACHED_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Activity import
ACTIVITY_SYNC_PAGE_SIZE=50
ACTIVITY_SYNC_OVERLAP_DAYS=2
ACTIVITY_SYNC_MAX_PAGES=100
ACTIVITY_STORE_SOURCE_FILES=true
ACTIVITY_SOURCE_FILE_DISK=activity_sources
FIT_NODE_BINARY=node
FIT_MAX_FILE_BYTES=52428800
FIT_PARSE_TIMEOUT_SECONDS=30
HEATMAP_PRIVACY_TRIM_M=400
HEATMAP_SAMPLE_EVERY=3

# Hammerhead / SRAM
HAMMERHEAD_ENABLED=false
HAMMERHEAD_HOSTED_APPROVED=false
HAMMERHEAD_TERMS_REVIEWED_AT=
HAMMERHEAD_REQUESTS_PER_MINUTE=60
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
HAMMERHEAD_REDIRECT_URI="${APP_URL}/api/v1/oauth/hammerhead/callback"
HAMMERHEAD_WEBHOOK_SECRET=
HAMMERHEAD_API_URL=https://api.hammerhead.io/v1/api
HAMMERHEAD_AUTH_URL=https://api.hammerhead.io/v1/auth
HAMMERHEAD_DISTANCE_MULTIPLIER=1
HAMMERHEAD_DURATION_MULTIPLIER=0.001

# WAHOO
WAHOO_ENABLED=false
WAHOO_HOSTED_APPROVED=false
WAHOO_TERMS_REVIEWED_AT=
# Conservative sandbox limits; use only the throughput approved for your app.
WAHOO_REQUESTS_PER_5_MINUTES=25
WAHOO_REQUESTS_PER_HOUR=100
WAHOO_REQUESTS_PER_DAY=250
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_SCOPES="user_read workouts_read offline_data"
WAHOO_CONFIDENTIAL=true
WAHOO_ENVIRONMENT=sandbox
WAHOO_REDIRECT_URI="${APP_URL}/api/v1/oauth/wahoo/callback"
WAHOO_API_URL=https://api.wahooligan.com/v1
WAHOO_AUTH_URL=https://api.wahooligan.com
WAHOO_WEBHOOK_ENABLED=false
WAHOO_WEBHOOK_URI=
WAHOO_WEBHOOK_TOKEN=
WAHOO_ALLOW_EXTERNAL_SHARING=false
