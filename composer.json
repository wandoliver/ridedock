{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "open-cycling/training-platform",
    "type": "project",
    "description": "Provider-neutral, open-source cycling activity ingestion and analysis API.",
    "keywords": ["cycling", "training", "hammerhead", "laravel"],
    "authors": [
        {
            "name": "Oliver Wand",
            "email": "oliwand@gmail.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "editorconfig-checker/editorconfig-checker": "^10.7",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.76",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": [
            "@lint:editorconfig",
            "@lint:javascript"
        ],
        "lint:editorconfig": "./vendor/bin/ec",
        "lint:javascript": "npm run lint",
        "phpcs": "./vendor/bin/phpcs --standard=PSR2 --extensions=php --exclude=Generic.Files.LineLength,Squiz.Functions.MultiLineFunctionDeclaration,Squiz.WhiteSpace.ScopeClosingBrace app",
        "cs-fixer": "./vendor/bin/php-cs-fixer fix --sequential",
        "cs-fixer:check": "./vendor/bin/php-cs-fixer fix --dry-run --diff --sequential --using-cache=no",
        "phpstan": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G ./vendor/bin/phpstan analyse --memory-limit=2G --debug"
        ],
        "check:quality": [
            "@composer validate --strict",
            "@check:repository",
            "@lint",
            "@phpcs",
            "@cs-fixer:check",
            "@phpstan"
        ],
        "check:install": "@php scripts/check-install.php",
        "check:repository": "node scripts/check-repository.mjs",
        "check": [
            "@test",
            "@check:quality",
            "npm run test:js",
            "npm run build",
            "@check:install"
        ],
        "precommit": [
            "@cs-fixer",
            "@phpcs"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
